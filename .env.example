# Copy this file to .env and fill in real values. Never commit .env -- it holds secrets.

# Supabase Postgres. Use the pooled connection (port 6543) for the app, and a direct,
# non-pooled connection (port 5432) for Prisma migrate/db push. pgbouncer=true and
# connection_limit=1 are required on the pooled URL -- without them, concurrent
# queries can crash with prepared-statement errors under Supabase's pgbouncer pooling.
# URL-encode special characters in the password (e.g. @ -> %40, ! -> %21).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Optional. When set, the AI Coach augments its deterministic static analysis with an
# LLM call. Everything works without it. The coach is fully functional offline.
# ANTHROPIC_API_KEY=

# Session-signing secret. A dev default is used if unset; set a long random value in
# production (e.g. `openssl rand -hex 32`).
# AUTH_SECRET=

# Optional. Enables "Continue with Google". Create OAuth credentials in Google Cloud
# and add http(s)://<host>/api/auth/google/callback as an authorized redirect URI.
# Email + password sign-in works without these.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional. PostHog analytics for tracking learner behavior. Create a project at posthog.com
# and add your project API key (e.g., phc_...). Analytics are fully functional without this.
# NEXT_PUBLIC_POSTHOG_KEY=

# Optional. Sells "Learn" (₹499), "Run" (₹999), and the bundle (₹1,199) for Meta Ads
# Mastery via Razorpay -- without these, the buy buttons show a "checkout isn't set
# up yet" message rather than erroring. Get keys from the Razorpay Dashboard ->
# Settings -> API Keys. Use the rzp_test_... keys while developing; switch to
# rzp_live_... only once the full buy -> pay -> unlock flow is verified with a real
# test payment.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard -> Settings -> Webhooks, after creating a webhook pointing
# at https://<your-domain>/api/payments/webhook subscribed to "payment.captured".
# RAZORPAY_WEBHOOK_SECRET=
