# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files -- .env.example is a safe, secret-free template and is intentionally
# committed so `git clone` documents what to set; everything else stays local-only.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# GrowthSQL Academy
# Generated marketing warehouse (~95 MB). Rebuild with `npm run setup`.
/.data/
# Learner progress database. Created by `npm run setup`.
/prisma/dev.db
/prisma/dev.db-journal
# Prisma client is generated into src/generated
/src/generated/


# Monaco editor assets, copied from node_modules by `npm run monaco`.
/public/monaco/
