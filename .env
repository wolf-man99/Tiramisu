# Local learner-progress database. No secrets here — this file is committed on purpose
# so a fresh clone runs without any setup. See docs/ARCHITECTURE.md §1.
DATABASE_URL="file:./dev.db"

# Optional. When set, the AI Coach augments its deterministic static analysis with an
# LLM call. Everything works without it — the coach is fully functional offline.
# ANTHROPIC_API_KEY=
